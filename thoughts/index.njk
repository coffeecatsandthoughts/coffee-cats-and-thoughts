---
permalink: "/thoughts/"
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Thoughts | Coffee, Cats & Thoughts</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #f7f2e9;
      color: #332b27;
      font-family: Georgia, "Times New Roman", serif;
      line-height: 1.7;
    }

    header {
      text-align: center;
      padding: 55px 20px 30px;
    }

    .eyebrow {
      font-family: Arial, sans-serif;
      font-size: 12px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #8a7566;
      margin-bottom: 15px;
    }

    .site-title {
      margin: 0;
      font-size: clamp(38px, 6vw, 60px);
      font-weight: normal;
      line-height: 1.1;
    }

    .site-title a {
      color: #332b27;
      text-decoration: none;
    }

    nav {
      border-top: 1px solid #d9cfc3;
      border-bottom: 1px solid #d9cfc3;
      text-align: center;
      padding: 15px 20px;
      font-family: Arial, sans-serif;
      font-size: 13px;
    }

    nav a {
      color: #51463f;
      text-decoration: none;
      margin: 0 14px;
    }

    main {
      width: min(900px, calc(100% - 40px));
      margin: 60px auto;
    }

    .archive-heading {
      margin-bottom: 45px;
    }

    .section-label {
      font-family: Arial, sans-serif;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 11px;
      color: #967d6b;
      margin-bottom: 10px;
    }

    h1 {
      font-size: clamp(38px, 6vw, 58px);
      font-weight: normal;
      margin: 0 0 10px;
    }

    .intro {
      max-width: 700px;
      color: #75675e;
      font-size: 17px;
    }

    .post {
      padding: 28px 0;
      border-top: 1px solid #ddd3c8;
    }

    .meta {
      font-family: Arial, sans-serif;
      color: #927e70;
      font-size: 12px;
      margin-bottom: 8px;
    }

    .post h2 {
      margin: 0;
      font-size: 28px;
      font-weight: normal;
      line-height: 1.3;
    }

    .post h2 a {
      color: #332b27;
      text-decoration: none;
    }

    footer {
      text-align: center;
      padding: 45px 20px;
      border-top: 1px solid #d9cfc3;
      color: #8a796d;
      font-family: Arial, sans-serif;
      font-size: 12px;
    }

    @media (max-width: 600px) {
      nav a {
        display: inline-block;
        margin: 5px 8px;
      }

      main {
        margin-top: 45px;
      }
    }
  </style>
</head>

<body>

  {% include "site-header.njk" %}

  <main>

    <section class="archive-heading">
      <div class="section-label">From the Journal</div>
      <h1>Thoughts</h1>

      <p class="intro">
        Reflections, observations, overthinking, and the things that stay in my head long enough to become words.
      </p>
    </section>

    {% for post in collections.blogPosts %}
      {% if post.data.category == "Thoughts" %}
      <article class="post">
        <div class="meta">
          {{ post.date | readableDate }}
        </div>

        <h2>
          <a href="{{ post.url }}">
            {{ post.data.title }}
          </a>
        </h2>
      </article>
      {% endif %}
    {% endfor %}

  </main>

  <footer>
    © 2026 Coffee, Cats & Thoughts · Written somewhere between coffee and everything else.
  </footer>

</body>
</html>
