---
permalink: /life/
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Life | Coffee, Cats, and Thoughts</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #f7f2e9;
      color: #332b27;
      font-family: Georgia, "Times New Roman", serif;
      line-height: 1.7;
    }

    header {
      text-align: center;
      padding: 48px 20px 30px;
      border-bottom: 1px solid #d9cfc2;
    }

    .journal-label,
    .section-label {
      font-family: Arial, sans-serif;
      letter-spacing: 3px;
      font-size: 12px;
      color: #9a6648;
    }

    .journal-label {
      font-style: italic;
    }

    .section-label {
      text-transform: uppercase;
      letter-spacing: 4px;
    }

    header h1 {
      margin: 12px 0 0;
      font-size: 52px;
      font-weight: normal;
      line-height: 1.15;
    }

    nav {
      text-align: center;
      padding: 16px;
      border-bottom: 1px solid #d9cfc2;
      font-family: Arial, sans-serif;
      font-size: 14px;
    }

    nav a {
      color: #332b27;
      text-decoration: none;
      margin: 0 18px;
    }

    nav a:hover {
      color: #9a6648;
    }

    main {
      max-width: 900px;
      margin: 0 auto;
      padding: 60px 20px 80px;
    }

    .intro {
      margin-bottom: 45px;
    }

    .intro h2 {
      font-size: 54px;
      font-weight: normal;
      margin: 18px 0 20px;
      line-height: 1.15;
    }

    .intro p {
      font-size: 18px;
      color: #795f50;
      max-width: 760px;
    }

    .post {
      padding: 28px 0;
      border-top: 1px solid #d9cfc2;
    }

    .post .meta {
      font-family: Arial, sans-serif;
      font-size: 12px;
      color: #9a6648;
      margin-bottom: 10px;
    }

    .post h3 {
      font-size: 28px;
      font-weight: normal;
      line-height: 1.3;
      margin: 0;
    }

    .post h3 a {
      color: #332b27;
      text-decoration: none;
    }

    .post h3 a:hover {
      color: #9a6648;
    }

    footer {
      text-align: center;
      border-top: 1px solid #d9cfc2;
      padding: 35px 20px;
      font-family: Arial, sans-serif;
      font-size: 12px;
      color: #8a7061;
    }

    @media (max-width: 650px) {
      header h1 {
        font-size: 40px;
      }

      .intro h2 {
        font-size: 42px;
      }

      nav a {
        margin: 0 7px;
        font-size: 12px;
      }
    }
  </style>
</head>

<body>

{% include "site-header.njk" %}

<main>

  <section class="intro">
    <div class="section-label">From the Journal</div>
    <h2>Life</h2>
    <p>
      The ordinary days, unexpected turns, memories, people, places,
      and little moments that somehow become part of the story.
    </p>
  </section>

  <section>

    {% for post in collections.blogPosts %}
      {% if post.data.category == "Life" %}

        <article class="post">
          <div class="meta">
            {{ post.date | readableDate }}
          </div>

          <h3>
            <a href="{{ post.url }}">
              {{ post.data.title }}
            </a>
          </h3>
        </article>

      {% endif %}
    {% endfor %}

  </section>

</main>

<footer>
  © 2026 Coffee, Cats, and Thoughts · Written somewhere between coffee and everything else.
</footer>

</body>
</html>
