<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | dump | safe }},
 "datePublished": "{{ date | dateToISO }}",
  "url": "https://coffeecatsandthoughts.com{{ page.url }}",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://coffeecatsandthoughts.com{{ page.url }}"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Coffee, Cats, and Thoughts"
  }
}
</script>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #f7f2e9;
      color: #332b27;
      font-family: Georgia, "Times New Roman", serif;
      line-height: 1.8;
    }

    header {
  text-align: center;
  padding: 0 20px 20px;
  border-bottom: 1px solid #d9cfc3;
}

    .site-title {
      font-size: 34px;
      font-weight: normal;
      margin: 0;
    }

    .site-title a {
      color: #332b27;
      text-decoration: none;
    }

    nav {
      text-align: center;
      padding: 14px 20px;
      border-bottom: 1px solid #d9cfc3;
      font-family: Arial, sans-serif;
      font-size: 13px;
    }

    nav a {
      color: #51463f;
      text-decoration: none;
      margin: 0 12px;
    }

    main {
    width: min(1100px, calc(100% - 40px));
    margin: 60px auto;
}

    .category {
      font-family: Arial, sans-serif;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 11px;
      color: #967d6b;
      margin-bottom: 12px;
    }

    h1 {
      font-size: clamp(36px, 6vw, 58px);
      line-height: 1.15;
      font-weight: normal;
      margin: 0 0 16px;
    }

    .date {
      font-family: Arial, sans-serif;
      font-size: 12px;
      color: #927e70;
      margin-bottom: 40px;
    }

    article {
      font-size: 18px;
    }

    article p {
      margin: 0 0 1.4em;
    }

    article h2,
    article h3 {
      font-weight: normal;
      line-height: 1.3;
      margin-top: 2em;
    }

    article figure {
    float: left;
    width: 280px;
    margin: 10px 35px 35px 0;
}

article figure img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    border-radius: 3px;
}

article figcaption {
    margin-top: 8px;
    font-family: Arial, sans-serif;
    font-size: 12px;
    line-height: 1.5;
    color: #927e70;
    font-style: italic;
}
article figure.photo-left {
    float: left;
    width: 300px;
    margin: 10px 35px 25px 0;
}

article figure.photo-right {
    float: right;
    width: 300px;
    margin: 10px 0 25px 35px;
}
article figure.wide-photo {
  float: none;
  width: 100%;
  max-width: 760px;
  margin: 35px auto;
}

article figure.wide-photo img {
  width: 100%;
}
.post-video {
    width: 100%;
    max-width: 760px;
    aspect-ratio: 16 / 9;
    margin: 35px auto;
}

.post-video iframe {
    width: 100%;
    height: 100%;
    display: block;
    border: 0;
    border-radius: 3px;
}
.pet-memorial {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin: 45px 0 18px;
}

.pet-memorial img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
    border-radius: 3px;
}
article::after {
    content: "";
    display: block;
    clear: both;
}

    article blockquote {
      margin: 35px 0;
      padding-left: 22px;
      border-left: 3px solid #b9a696;
      color: #66584f;
      font-style: italic;
    }

    .post-navigation {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  margin-top: 55px;
  padding-top: 30px;
  border-top: 1px solid #d9cfc2;
}

.previous-post,
.next-post {
  display: flex;
  flex-direction: column;
}

.next-post {
  text-align: right;
  align-items: flex-end;
}

.post-nav-label {
  font-family: Arial, sans-serif;
  font-size: 11px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: #9a6648;
  margin-bottom: 8px;
}

.post-navigation a {
  color: #332b27;
  text-decoration: none;
  font-size: 18px;
  line-height: 1.4;
}

.post-navigation a:hover {
  text-decoration: underline;
}

    footer {
      text-align: center;
      padding: 40px 20px;
      border-top: 1px solid #d9cfc3;
      color: #8a796d;
      font-family: Arial, sans-serif;
      font-size: 12px;
    }
.post-layout {
  display: grid;
  grid-template-columns: minmax(0, 760px) 260px;
  gap: 60px;
  align-items: start;
}

.recent-posts {
  border-left: 1px solid #d9cfc2;
  padding-left: 28px;
}

.sidebar-label {
  font-family: Arial, sans-serif;
  font-size: 11px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: #9a6648;
  margin-bottom: 20px;
}

.recent-post-link {
  display: block;
  color: #332b27;
  text-decoration: none;
  font-size: 16px;
  line-height: 1.4;
  padding: 12px 0;
  border-bottom: 1px solid #e5ddd3;
}

.recent-post-link:hover {
  text-decoration: underline;
}
.comments-section {
    margin-top: 55px;
    padding-top: 40px;
    border-top: 1px solid #d9cfc3;
}

.comments-heading {
    margin-bottom: 30px;
}

.comments-label {
    font-family: Arial, sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #9a6648;
    margin-bottom: 10px;
}

.comments-heading h2,
.reader-comments h2 {
    font-size: 28px;
    font-weight: normal;
    margin: 0 0 8px;
}

.comments-heading p {
    margin: 0;
    color: #68584f;
    font-style: italic;
}

.comment-field {
    margin-bottom: 20px;
}

.comment-field label {
    display: block;
    font-family: Arial, sans-serif;
    font-size: 12px;
    color: #68584f;
    margin-bottom: 7px;
}

.comment-field label span {
    color: #927e70;
    font-size: 11px;
}

.comment-field input,
.comment-field textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #d9cfc3;
    border-radius: 3px;
    background: #fffdf9;
    color: #332b27;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 16px;
}

.comment-field textarea {
    resize: vertical;
    min-height: 130px;
}

.comment-field input:focus,
.comment-field textarea:focus {
    outline: none;
    border-color: #9a6648;
}

.comment-submit {
    border: 0;
    border-radius: 3px;
    background: #9a6648;
    color: #fff;
    padding: 12px 20px;
    font-family: Arial, sans-serif;
    font-size: 12px;
    cursor: pointer;
}

.comment-submit:hover {
    opacity: 0.88;
}

.comment-message {
    margin-top: 15px;
    font-size: 14px;
    font-style: italic;
}

.reader-comments {
    margin-top: 45px;
}

.reader-comments h2 {
    padding-bottom: 12px;
    border-bottom: 1px solid #e5dbd3;
}

.reader-comment {
    padding: 18px 0;
    border-bottom: 1px solid #e5dbd3;
}

.reader-comment strong {
    display: inline-block;
    margin-right: 10px;
}

.reader-comment-date {
    font-family: Arial, sans-serif;
    font-size: 11px;
    color: #927e70;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.reader-comment p {
    margin: 10px 0 0;
}

.comments-loading {
    color: #927e70;
    font-style: italic;
    font-size: 14px;
}
@media (max-width: 650px) {
  .post-navigation {
    grid-template-columns: 1fr;
    gap: 25px;
  }

.pet-memorial {
    grid-template-columns: repeat(3, 1fr);
    gap: 5px;
    margin: 35px 0 16px;
}
  .next-post {
    text-align: left;
    align-items: flex-start;
  }
.post-layout {
  grid-template-columns: 1fr;
  gap: 45px;

article figure {
    float: none;
    width: 100%;
    max-width: 320px;
    margin: 30px auto;
}
}

.recent-posts {
  border-left: none;
  border-top: none;
  padding-left: 0;
  padding-top: 30px;
}
}

@media (max-width: 600px) {
  .solar-bill-comparison {
    flex-direction: column;
  }

  .solar-bill-comparison figure {
    width: 100%;
  }
}

/* Blog post sharing buttons */
.post-share {
  margin: 35px 0;
  padding: 22px 0;
  border-top: 1px solid #ddd4c8;
  border-bottom: 1px solid #ddd4c8;
  text-align: center;
}

.post-share-label {
  display: block;
  margin-bottom: 15px;
  font-size: 16px;
  font-weight: 600;
}

.post-share-buttons {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10px;
}

.post-share-buttons a,
.post-share-buttons button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  padding: 0;
  border: 1px solid #bca995;
  border-radius: 50%;
  background: transparent;
  color: inherit;
  font-family: Arial, sans-serif;
  font-size: 19px;
  font-weight: 500;
  text-decoration: none;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.2s ease;
}

.post-share-buttons svg {
  display: block;
}

.post-share-buttons a:hover,
.post-share-buttons button:hover {
  background: #e8ded1;
  transform: translateY(-2px);
}

  </style>
</head>

<body>

  {% include "site-header.njk" %}

  <main>
    <div class="category">{{ category }}</div>

    <h1>{{ title }}</h1>

    <div class="date">
      {{ date | readableDate }}
    </div>
<div class="post-layout">
  <div class="post-content">

    <article>
      {{ content | safe }}
    </article>

<div class="post-share" aria-label="Share this post">
  <span class="post-share-label">Enjoyed this post? Share it!</span>

 <div class="post-share-buttons">
  <a id="share-facebook" href="#" target="_blank" rel="noopener noreferrer"
     aria-label="Share on Facebook" title="Share on Facebook">
    <span aria-hidden="true">f</span>
  </a>

  <a id="share-x" href="#" target="_blank" rel="noopener noreferrer"
     aria-label="Share on X" title="Share on X">
    <span aria-hidden="true">𝕏</span>
  </a>

  <button type="button" id="share-copy"
          aria-label="Copy link" title="Copy link">
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24"
         fill="none" stroke="currentColor" stroke-width="1.8"
         stroke-linecap="round" stroke-linejoin="round">
      <rect x="8" y="8" width="12" height="12" rx="2"/>
      <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/>
    </svg>
  </button>

  <button type="button" id="share-native" style="display:none;"
          aria-label="More sharing options" title="More sharing options">
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24"
         fill="none" stroke="currentColor" stroke-width="1.8"
         stroke-linecap="round" stroke-linejoin="round">
      <circle cx="18" cy="5" r="3"/>
      <circle cx="6" cy="12" r="3"/>
      <circle cx="18" cy="19" r="3"/>
      <path d="m8.7 13.5 6.6 4m0-11-6.6 4"/>
    </svg>
  </button>
</div>
</div>

<section class="comments-section" data-post="{{ page.url }}">
  <div class="comments-heading">
    <div class="comments-label">Join the Conversation</div>
    <h2>Leave a Thought</h2>
    <p>Have something to say? I'd love to hear it.</p>
  </div>

  <form id="comment-form">
    <div class="comment-field">
      <label for="comment-name">Name</label>
      <input type="text" id="comment-name" name="name" maxlength="80" required>
    </div>

    <div class="comment-field">
      <label for="comment-email">
        Email <span>(won't be published)</span>
      </label>
      <input type="email" id="comment-email" name="email" maxlength="200">
    </div>

    <div class="comment-field">
      <label for="comment-text">Your thought</label>
      <textarea id="comment-text" name="comment" rows="6" maxlength="3000" required></textarea>
    </div>

    <button type="submit" class="comment-submit">Leave my thought →</button>

    <p id="comment-message" class="comment-message"></p>
  </form>

  <div class="reader-comments">
    <h2>Thoughts from Readers</h2>
    <div id="comments-list">
      <p class="comments-loading">Loading thoughts...</p>
    </div>
  </div>
</section>
{% include "newsletter-signup.njk" %}
    {% set previous = collections.blogPosts | previousPost(page.url) %}
{% set next = collections.blogPosts | nextPost(page.url) %}

<nav class="post-navigation">

  <div class="previous-post">
    {% if previous %}
      <span class="post-nav-label">← Previous Post</span>
      <a href="{{ previous.url }}">
        {{ previous.data.title }}
      </a>
    {% endif %}
  </div>

  <div class="next-post">
    {% if next %}
      <span class="post-nav-label">Next Post →</span>
      <a href="{{ next.url }}">
        {{ next.data.title }}
      </a>
    {% endif %}
  </div>

</nav>
  </div>

  <aside class="recent-posts">
    <div class="sidebar-label">Recent Posts</div>

   {% for post in collections.blogPosts | recentPosts(page.url) %}
    
        <a href="{{ post.url }}" class="recent-post-link">
          {{ post.data.title }}
        </a>
     
    {% endfor %}
  </aside>
</div>
  </main>

  {% include "site-footer.njk" %}

<script>
document.addEventListener("DOMContentLoaded", function () {
  const section = document.querySelector(".comments-section");
  const form = document.getElementById("comment-form");
  const commentsList = document.getElementById("comments-list");
  const message = document.getElementById("comment-message");

  if (!section || !form || !commentsList) return;

  const post = section.dataset.post;

  async function loadComments() {
    try {
      const response = await fetch(
        "/api/comments?post=" + encodeURIComponent(post)
      );

      const data = await response.json();
      const comments = data.comments || [];

      if (comments.length === 0) {
        commentsList.innerHTML =
          '<p class="comments-loading">No thoughts yet. Be the first to leave one.</p>';
        return;
      }

      commentsList.innerHTML = "";

      comments.forEach(function (item) {
        const comment = document.createElement("div");
        comment.className = "reader-comment";

        const name = document.createElement("strong");
        name.textContent = item.name;

        const date = document.createElement("span");
        date.className = "reader-comment-date";

        const parsedDate = new Date(item.created_at.replace(" ", "T") + "Z");

date.textContent = parsedDate.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "Asia/Manila"
});

        const text = document.createElement("p");
        text.textContent = item.comment;

        comment.appendChild(name);
        comment.appendChild(date);
        comment.appendChild(text);

if (item.replies && item.replies.length > 0) {
  item.replies.forEach(function (reply) {
    const replyBox = document.createElement("div");

    replyBox.style.margin = "15px 0 5px 20px";
    replyBox.style.padding = "12px 15px";
    replyBox.style.borderLeft = "3px solid #9a6648";
    replyBox.style.background = "#f7f2e9";

    const replyAuthor = document.createElement("strong");
    replyAuthor.textContent = "J. · Author";

    const replyText = document.createElement("p");
    replyText.textContent = reply.reply;
    replyText.style.margin = "8px 0 0";

    replyBox.appendChild(replyAuthor);
    replyBox.appendChild(replyText);
    comment.appendChild(replyBox);
  });
}

        commentsList.appendChild(comment);
      });
    } catch (error) {
      commentsList.innerHTML =
        '<p class="comments-loading">Comments couldn’t be loaded right now.</p>';
    }
  }

  form.addEventListener("submit", async function (event) {
    event.preventDefault();

    const button = form.querySelector(".comment-submit");

    const payload = {
      post: post,
      name: document.getElementById("comment-name").value.trim(),
      email: document.getElementById("comment-email").value.trim(),
      comment: document.getElementById("comment-text").value.trim()
    };

    button.disabled = true;
    button.textContent = "Sending...";
    message.textContent = "";

    try {
      const response = await fetch("/api/comments", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify(payload)
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || "Something went wrong.");
      }

      message.textContent =
        data.message || "Thanks! Your comment is waiting for approval.";

      form.reset();
    } catch (error) {
      message.textContent =
        error.message || "Something went wrong. Please try again.";
    } finally {
      button.disabled = false;
      button.textContent = "Leave my thought →";
    }
  });

  loadComments();
});
</script>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const postUrl = window.location.href.split("#")[0];
  const postTitle = document.title;

  const facebook = document.getElementById("share-facebook");
  const x = document.getElementById("share-x");
  const copy = document.getElementById("share-copy");
  const native = document.getElementById("share-native");

  if (facebook) {
    facebook.href =
      "https://www.facebook.com/sharer/sharer.php?u=" +
      encodeURIComponent(postUrl);
  }

  if (x) {
    x.href =
      "https://twitter.com/intent/tweet?text=" +
      encodeURIComponent(postTitle) +
      "&url=" +
      encodeURIComponent(postUrl);
  }

  if (copy) {
    copy.addEventListener("click", async function () {
      try {
        await navigator.clipboard.writeText(postUrl);
       copy.setAttribute("aria-label", "Link copied!");
copy.setAttribute("title", "Link copied!");

setTimeout(function () {
  copy.setAttribute("aria-label", "Copy link");
  copy.setAttribute("title", "Copy link");
}, 2000);
      } catch (error) {
        copy.setAttribute("aria-label", "Unable to copy link");
copy.setAttribute("title", "Unable to copy link");
      }
    });
  }

  if (native && navigator.share) {
    native.style.display = "inline-block";

    native.addEventListener("click", async function () {
      try {
        await navigator.share({
          title: postTitle,
          url: postUrl
        });
      } catch (error) {
        // User cancelled sharing.
      }
    });
  }
});
</script>

</body>
</html>
