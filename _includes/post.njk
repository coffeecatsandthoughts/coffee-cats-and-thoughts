<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{{ title }} | Coffee, Cats & Thoughts</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #f7f2e9;
      color: #332b27;
      font-family: Georgia, "Times New Roman", serif;
      line-height: 1.8;
    }

    header {
      text-align: center;
      padding: 45px 20px 25px;
      border-bottom: 1px solid #d9cfc3;
    }

    .site-title {
      font-size: 34px;
      font-weight: normal;
      margin: 0;
    }

    .site-title a {
      color: #332b27;
      text-decoration: none;
    }

    nav {
      text-align: center;
      padding: 14px 20px;
      border-bottom: 1px solid #d9cfc3;
      font-family: Arial, sans-serif;
      font-size: 13px;
    }

    nav a {
      color: #51463f;
      text-decoration: none;
      margin: 0 12px;
    }

    main {
    width: min(1100px, calc(100% - 40px));
    margin: 60px auto;
}

    .category {
      font-family: Arial, sans-serif;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 11px;
      color: #967d6b;
      margin-bottom: 12px;
    }

    h1 {
      font-size: clamp(36px, 6vw, 58px);
      line-height: 1.15;
      font-weight: normal;
      margin: 0 0 16px;
    }

    .date {
      font-family: Arial, sans-serif;
      font-size: 12px;
      color: #927e70;
      margin-bottom: 40px;
    }

    article {
      font-size: 18px;
    }

    article p {
      margin: 0 0 1.4em;
    }

    article h2,
    article h3 {
      font-weight: normal;
      line-height: 1.3;
      margin-top: 2em;
    }

    article figure {
    float: left;
    width: 280px;
    margin: 10px 35px 35px 0;
}

article figure img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    border-radius: 3px;
}

article figcaption {
    margin-top: 8px;
    font-family: Arial, sans-serif;
    font-size: 12px;
    line-height: 1.5;
    color: #927e70;
    font-style: italic;
}

article figure.wide-photo {
  float: none;
  width: 100%;
  max-width: 760px;
  margin: 35px auto;
}

article figure.wide-photo img {
  width: 100%;
}

article::after {
    content: "";
    display: block;
    clear: both;
}

    article blockquote {
      margin: 35px 0;
      padding-left: 22px;
      border-left: 3px solid #b9a696;
      color: #66584f;
      font-style: italic;
    }

    .post-navigation {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  margin-top: 55px;
  padding-top: 30px;
  border-top: 1px solid #d9cfc2;
}

.previous-post,
.next-post {
  display: flex;
  flex-direction: column;
}

.next-post {
  text-align: right;
  align-items: flex-end;
}

.post-nav-label {
  font-family: Arial, sans-serif;
  font-size: 11px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: #9a6648;
  margin-bottom: 8px;
}

.post-navigation a {
  color: #332b27;
  text-decoration: none;
  font-size: 18px;
  line-height: 1.4;
}

.post-navigation a:hover {
  text-decoration: underline;
}

    footer {
      text-align: center;
      padding: 40px 20px;
      border-top: 1px solid #d9cfc3;
      color: #8a796d;
      font-family: Arial, sans-serif;
      font-size: 12px;
    }
.post-layout {
  display: grid;
  grid-template-columns: minmax(0, 760px) 260px;
  gap: 60px;
  align-items: start;
}

.recent-posts {
  border-left: 1px solid #d9cfc2;
  padding-left: 28px;
}

.sidebar-label {
  font-family: Arial, sans-serif;
  font-size: 11px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: #9a6648;
  margin-bottom: 20px;
}

.recent-post-link {
  display: block;
  color: #332b27;
  text-decoration: none;
  font-size: 16px;
  line-height: 1.4;
  padding: 12px 0;
  border-bottom: 1px solid #e5ddd3;
}

.recent-post-link:hover {
  text-decoration: underline;
}
@media (max-width: 650px) {
  .post-navigation {
    grid-template-columns: 1fr;
    gap: 25px;
  }

  .next-post {
    text-align: left;
    align-items: flex-start;
  }
.post-layout {
  grid-template-columns: 1fr;
  gap: 45px;

article figure {
    float: none;
    width: 100%;
    max-width: 320px;
    margin: 30px auto;
}
}

.recent-posts {
  border-left: none;
  border-top: none;
  padding-left: 0;
  padding-top: 30px;
}
}
  </style>
</head>

<body>

  {% include "site-header.njk" %}

  <main>
    <div class="category">{{ category }}</div>

    <h1>{{ title }}</h1>

    <div class="date">
      {{ date | readableDate }}
    </div>
<div class="post-layout">
  <div class="post-content">

    <article>
      {{ content | safe }}
    </article>

    {% set previous = collections.blogPosts | previousPost(page.url) %}
{% set next = collections.blogPosts | nextPost(page.url) %}

<nav class="post-navigation">

  <div class="previous-post">
    {% if previous %}
      <span class="post-nav-label">← Previous Post</span>
      <a href="{{ previous.url }}">
        {{ previous.data.title }}
      </a>
    {% endif %}
  </div>

  <div class="next-post">
    {% if next %}
      <span class="post-nav-label">Next Post →</span>
      <a href="{{ next.url }}">
        {{ next.data.title }}
      </a>
    {% endif %}
  </div>

</nav>
  </div>

  <aside class="recent-posts">
    <div class="sidebar-label">Recent Posts</div>

   {% for post in collections.blogPosts | recentPosts(page.url) %}
    
        <a href="{{ post.url }}" class="recent-post-link">
          {{ post.data.title }}
        </a>
     
    {% endfor %}
  </aside>
</div>
  </main>

  {% include "site-footer.njk" %}

</body>
</html>
