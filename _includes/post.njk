<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{{ title }} | Coffee, Cats & Thoughts</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #f7f2e9;
      color: #332b27;
      font-family: Georgia, "Times New Roman", serif;
      line-height: 1.8;
    }

    header {
      text-align: center;
      padding: 45px 20px 25px;
      border-bottom: 1px solid #d9cfc3;
    }

    .site-title {
      font-size: 34px;
      font-weight: normal;
      margin: 0;
    }

    .site-title a {
      color: #332b27;
      text-decoration: none;
    }

    nav {
      text-align: center;
      padding: 14px 20px;
      border-bottom: 1px solid #d9cfc3;
      font-family: Arial, sans-serif;
      font-size: 13px;
    }

    nav a {
      color: #51463f;
      text-decoration: none;
      margin: 0 12px;
    }

    main {
      width: min(760px, calc(100% - 40px));
      margin: 60px auto;
    }

    .category {
      font-family: Arial, sans-serif;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 11px;
      color: #967d6b;
      margin-bottom: 12px;
    }

    h1 {
      font-size: clamp(36px, 6vw, 58px);
      line-height: 1.15;
      font-weight: normal;
      margin: 0 0 16px;
    }

    .date {
      font-family: Arial, sans-serif;
      font-size: 12px;
      color: #927e70;
      margin-bottom: 40px;
    }

    article {
      font-size: 18px;
    }

    article p {
      margin: 0 0 1.4em;
    }

    article h2,
    article h3 {
      font-weight: normal;
      line-height: 1.3;
      margin-top: 2em;
    }

    article img {
      display: block;
      max-width: 100%;
      height: auto;
      margin: 35px auto;
      border-radius: 3px;
    }

    article blockquote {
      margin: 35px 0;
      padding-left: 22px;
      border-left: 3px solid #b9a696;
      color: #66584f;
      font-style: italic;
    }

    .back {
      display: inline-block;
      margin-top: 50px;
      font-family: Arial, sans-serif;
      font-size: 13px;
      color: #6c5547;
      text-decoration: none;
    }

    footer {
      text-align: center;
      padding: 40px 20px;
      border-top: 1px solid #d9cfc3;
      color: #8a796d;
      font-family: Arial, sans-serif;
      font-size: 12px;
    }
  </style>
</head>

<body>

  {% include "site-header.njk" %}

  <main>
    <div class="category">{{ category }}</div>

    <h1>{{ title }}</h1>

    <div class="date">
      {{ date | readableDate }}
    </div>

    <article>
      {{ content | safe }}
    </article>

    <a class="back" href="/">← Back to all thoughts</a>
  </main>

  <footer>
    © 2026 Coffee, Cats & Thoughts
  </footer>

</body>
</html>
